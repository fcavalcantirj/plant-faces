# Copy to secrets.yaml (gitignored — see repo .gitignore) and fill in.
# secrets.yaml never leaves the desk; everything in it ends up baked into
# flash, which is why the token below is a low-privilege source token and not
# an account credential.

wifi_ssid: "CHANGE_ME"
wifi_password: "CHANGE_ME"

# Minted server-side — src_ + 24 hex chars. One token per physical node.
device_token: "src_CHANGE_ME_24_HEX"

# ⚠ Confirm the real prod domain before Wave 1 bring-up — this placeholder
# will not resolve. During the smoke chain (T1.3) this same field points at
# webhook.site, then local dev, then prod, in that order.
ingest_url: "https://CHANGE-ME.vercel.app/api/ingest"
